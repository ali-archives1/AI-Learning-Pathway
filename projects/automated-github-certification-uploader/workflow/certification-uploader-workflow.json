    {
      "parameters": {
        "jsCode": "// Content-based duplicate protection.\n// Compute a SHA-256 of each file's actual binary content and keep only the\n// first item for each distinct hash. Crucially, we return the ORIGINAL item\n// objects so their binary (property \"data\") is preserved for the GitHub upload.\n// (The previous Crypto node computed the hash but dropped binary from its\n// output, which is why the upload failed with \"reading 'data'\".)\nconst crypto = require('crypto');\n\nconst seen = new Set();\nconst unique = [];\nconst items = $input.all();\n\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  let hash = null;\n\n  if (item.binary && item.binary.data) {\n    const buffer = await this.helpers.getBinaryDataBuffer(i, 'data');\n    hash = crypto.createHash('sha256').update(buffer).digest('hex');\n  }\n\n  // Record the hash on json for visibility/debugging.\n  item.json.contentHash = hash;\n\n  if (hash) {\n    if (seen.has(hash)) {\n      continue; // duplicate content — skip\n    }\n    seen.add(hash);\n  }\n\n  unique.push(item);\n}\n\nreturn unique;"
      },
      "id": "6c579b5f-0070-4722-9805-a7d66c5afc98",
      "name": "Dedupe by content hash",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
