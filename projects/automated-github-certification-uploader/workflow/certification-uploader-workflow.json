    {
      "parameters": {
        "jsCode": "// Drive files from the folder listing\nconst driveFiles = $('List Drive folder files').all()\n  .map(i => i.json)\n  .filter(f => f && f.id && f.name);\n\n// Existing files already in the GitHub certificates/ folder.\n// GitHub list items carry a 'sha'; if the folder was missing the node's\n// error-passthrough output would carry Drive items instead (no sha) — exclude those.\nconst existingNames = new Set(\n  $('List existing GitHub files').all()\n    .filter(i => i.json && i.json.sha && i.json.name)\n    .map(i => i.json.name)\n);\n\n// Keep only Drive files not already present in the repo\nconst newFiles = driveFiles.filter(f => !existingNames.has(f.name));\n\nreturn newFiles.map(f => ({ json: { id: f.id, name: f.name } }));"
      },
